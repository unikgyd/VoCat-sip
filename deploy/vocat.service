[Unit]
Description=vocat cellular and VoWiFi control service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/vocat
ExecStart=/opt/vocat/bin/vocat
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
# HTTP, data, carrier, media and device owners drain with separate budgets.
TimeoutStopSec=120s
RuntimeDirectory=vocat
RuntimeDirectoryMode=0700
Environment=VOCAT_DATABASE_PATH=/opt/vocat/data/vocat.db
EnvironmentFile=/etc/vocat/vocat.env

AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=false
ProtectSystem=strict
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
# Keep kernel protection, with the data/USB and IPv6 settings needed by the
# selected original modem and the shared Host IMS reservation directory.
ReadWritePaths=/opt/vocat/data /run/lock -/proc/sys/net/ipv6/conf /sys/devices
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
